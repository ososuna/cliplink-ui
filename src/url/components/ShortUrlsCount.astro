---
import { UrlService } from "@/url/services";

const token = Astro.cookies.get("access_token")?.value;
const response = await UrlService.getUrlsCount(token);
const urlsCount = response.ok ? response.data : 0;
---

<p class="flex items-center">
  <span class="text-2xl font-bold mr-2">{urlsCount}</span>
  URLs shortened
</p>
