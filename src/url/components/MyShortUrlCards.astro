---
import type { Url } from "@/url/entities";
import { UrlService } from "@/url/services";
import MyShortUrlCard from '@/url/components/MyShortUrlCard.astro';
import {
  Pagination,
  PaginationContent,
  PaginationItem,
  PaginationLink,
  PaginationNext,
  PaginationPrevious
} from '@/styled-components/pagination';

interface Props {
  pageNumber: number;
  size: number;
  search: string;
}
const { pageNumber, size, search } = Astro.props;

// workaround for view transition bug
// sometimes when the logout use case is called the token is not cleared at time
// so '/' is redirecting to dashboard instead of home
// this is happening around 1 of 10 times the user logs out.
let isAuthenticated = true;

const token = Astro.cookies.get('access_token')?.value;
if (!token) isAuthenticated = false;

const response = await UrlService.getUrls(pageNumber, size, search, token);
const page = response.ok ? response.data : null;

---
{!isAuthenticated ? (
  <script>window.location.href = '/';</script>
) : !response.ok ? (
  <p class="px-8 text-center text-sm text-muted-foreground">
    There was an error retrieving the data. Please try again later. If the problem persists, please contact support.
  </p>
) : (
  page && (
    page.content.length === 0 ? (
      search ? (
        <p class="px-8 text-center text-sm text-muted-foreground">
          No URLs found matching "<strong>{search}</strong>". Please try a
          different search term
        </p>
      ) : (
        <p class="px-8 text-center text-sm text-muted-foreground">
          You haven't shortened any URLs yet. Click the <strong>"Shorten
            URL"</strong> button to shorten your first URL
        </p>
      )
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {page.content.map((url: Url) => (
          <MyShortUrlCard url={url} />
        ))}
      </div>
      <div class="mt-6">
        <Pagination>
          <PaginationContent>
            <PaginationItem>
              <PaginationPrevious
                disabled={page.first}
                href={`/dashboard?page=${pageNumber-1}&size=${size}&search=${search}`}
                size="default"
              />
            </PaginationItem>
            {Array.from({ length: page.totalPages }, (_, index) => (
              <PaginationItem key={index}>
                <PaginationLink
                  href={`/dashboard?page=${index}&size=${size}&search=${search}`}
                  isActive={index === pageNumber}
                  size="icon"
                >
                  {index + 1}
                </PaginationLink>
              </PaginationItem>
            ))}
            <PaginationItem>
              <PaginationNext
                disabled={page.last}
                href={`/dashboard?page=${pageNumber+1}&size=${size}&search=${search}`}
                size="default"
              />
            </PaginationItem>
          </PaginationContent>
        </Pagination>
      </div>
    )
  )
)}